# Google Places API (New) -- https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" on the project this key belongs to.
GOOGLE_PLACES_API_KEY=

# Supabase -- Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use the service_role key (not anon) since this runs server-side and needs write access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tuning knobs (all optional, sensible defaults in src/config.py) ---
MIN_RATING=4.0
MIN_REVIEWS=15
PLACES_RPM=50
SITE_GRADE_DELAY_SECONDS=2.0
SITE_GRADE_TIMEOUT_MS=15000
SCREENSHOT_DIR=./screenshots
