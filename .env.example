# Google Places API (New) -- https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" on the project this key belongs to.
GOOGLE_PLACES_API_KEY=

# Supabase -- Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use the service_role key (not anon) since this runs server-side and needs write access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tuning knobs (all optional, sensible defaults in src/config.py) ---
# Defaults are 0/0 (no reputation filter) per the "golden lead = bad website only"
# decision -- raise these back up later if you want to reintroduce a rating/review bar.
MIN_RATING=0
MIN_REVIEWS=0
PLACES_RPM=50
SITE_GRADE_DELAY_SECONDS=2.0
SITE_GRADE_TIMEOUT_MS=15000
# How many websites to grade/email-search concurrently. Each worker launches its
# own Playwright browser instance. On Render's cheapest worker tier (512MB-1GB
# RAM), keep this at 4-6. Higher if you upgrade the instance size.
GRADE_WORKERS=6
SCREENSHOT_DIR=./screenshots

# --- Instantly.ai (only needed for `python run.py push-instantly`) ---
# Workspace Settings -> Integrations -> API -> generate a v2 key with leads:create scope
INSTANTLY_API_KEY=
# Create the campaign (and write its email sequence) in the Instantly dashboard first,
# then copy its ID from the campaign's URL or the API's list-campaigns response.
INSTANTLY_CAMPAIGN_ID=
